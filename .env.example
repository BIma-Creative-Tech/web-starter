# Env runtime web-starter (KONTRAK container — dipakai templates/web-client di repo infra).
# JANGAN commit .env berisi nilai asli. Tidak ada secret di NEXT_PUBLIC_*.

# Wajib. URL publik kanonik (tanpa slash di akhir). Host berisi label "staging" → noindex.
SITE_URL=http://localhost:3000

# Form kontak (default mati). Bila true, semua SMTP_* di bawah WAJIB diisi (dicek saat boot).
CONTACT_ENABLED=false
SMTP_HOST=
# 465 = TLS implisit; selain itu STARTTLS wajib.
SMTP_PORT=587
SMTP_USER=
SMTP_FROM_ADDRESS=
# Path file berisi password SMTP (Docker secret / bind mount read-only), BUKAN password-nya.
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
